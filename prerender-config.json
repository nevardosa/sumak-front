{
  "prerender": {
    "builder": "@nguniversal/builders:prerender",
    "options": {
      "routes": [
        "/",
        "/catalog",
        "/faq"
      ]
    },
    "configurations": {
      "production": {
        "browserTarget": "sumak-front:build:production",
        "serverTarget": "sumak-front:server:production"
      }
    }
  }
}

